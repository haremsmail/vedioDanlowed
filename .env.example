APP_NAME="Video Downloader"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://danlwoedvideio.test
APP_TIMEZONE=Asia/Baghdad
APP_LOCALE=ku
APP_FALLBACK_LOCALE=en

DB_CONNECTION=sqlite
SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync
LOG_CHANNEL=stack
LOG_LEVEL=debug

# ─── yt-dlp ─────────────────────────────────────
YTDLP_PATH=yt-dlp
# FFMPEG_PATH=
# YTDLP_PROXY=
# YTDLP_COOKIES_FILE=   (default: storage/app/cookies.txt)

# spawn = start one process per download (local / Windows)
# daemon = `php artisan video:worker` must be running (Docker does this for you)
DOWNLOAD_WORKER=spawn

MAX_DOWNLOAD_SIZE=2G
MAX_CONCURRENT_DOWNLOADS=3
MAX_CONCURRENT_PER_IP=1
FILE_TTL_MINUTES=60

# ─── Rate limits (requests per minute per IP) ───
RATE_LIMIT_ANALYZE=15
RATE_LIMIT_DOWNLOAD=8
RATE_LIMIT_STATUS=120

# ─── Ads / income ───────────────────────────────
ADSENSE_CLIENT=
ADSENSE_SLOT_TOP=
ADSENSE_SLOT_MIDDLE=
ADSENSE_SLOT_BOTTOM=
ADS_CUSTOM=false
ADS_TXT=
GA_MEASUREMENT_ID=
