APP_NAME="Video Downloader"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://yourdomain.com
APP_TIMEZONE=Asia/Baghdad
APP_LOCALE=ku
APP_FALLBACK_LOCALE=en

DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# yt-dlp path (use 'yt-dlp' if in PATH, or full path like /usr/local/bin/yt-dlp)
YTDLP_PATH=yt-dlp

# Optional: ffmpeg directory path (if not in PATH)
# FFMPEG_PATH=/usr/local/bin

# Download storage
DOWNLOADS_PATH=downloads
MAX_DOWNLOAD_SIZE=10737418240

# Rate limiting (requests per period)
RATE_LIMIT=60
RATE_LIMIT_PERIOD=60

# Optional: API token for external API access (leave empty for public website mode)
# API_TOKEN=
# API_TOKEN_SECONDARY=
