APP_NAME="Video Downloader"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://yourdomain.onrender.com
APP_TIMEZONE=Asia/Baghdad
APP_LOCALE=ku
APP_FALLBACK_LOCALE=en

# ─── Database ───────────────────────────────────
# PostgreSQL is recommended for Render
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=videodl
DB_USERNAME=postgres
DB_PASSWORD=secret

# (On Render, you can just provide DATABASE_URL instead of the individual variables)

# ─── Drivers ────────────────────────────────────
BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# ─── Logging ────────────────────────────────────
LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# ─── yt-dlp ─────────────────────────────────────
# Path to yt-dlp binary (use 'yt-dlp' if in PATH)
YTDLP_PATH=yt-dlp

# Path to ffmpeg directory (leave empty to auto-detect)
# FFMPEG_PATH=

# ─── Download Storage ───────────────────────────
DOWNLOADS_PATH=downloads
MAX_DOWNLOAD_SIZE=10737418240

# ─── Rate Limiting ──────────────────────────────
RATE_LIMIT=60
RATE_LIMIT_PERIOD=60

# ─── API Authentication (optional) ──────────────
# Leave empty for public website mode
# API_TOKEN=
# API_TOKEN_SECONDARY=
